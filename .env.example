# NeuroDecode LLM backend configuration.
#
# Copy this file to `.env` and fill in the values you need:
#   cp .env.example .env
#
# The demo loads `.env` automatically at startup (no extra dependency).
# `.env` is git-ignored, so real keys never reach the repository.
# Real environment variables always take precedence over `.env` values.

# ------------------------------------------------------------------
# Option: OpenAI-compatible API backend  (run with --backend api)
# Works with DeepSeek / OpenAI / Moonshot / local vLLM / any
# endpoint that implements /chat/completions.
# ------------------------------------------------------------------
#LLM_API_URL=https://api.deepseek.com/v1
#LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
#LLM_API_MODEL=deepseek-chat

# ------------------------------------------------------------------
# Option: Coze agent backend  (run with --backend coze)
# Relay prompts through an agent deployed on Coze.
# ------------------------------------------------------------------
#COZE_AGENT_DOMAIN=https://your-agent-domain.coze.site
#COZE_PROJECT_ID=7600000000000000000
#COZE_API_TOKEN=pat_xxxxxxxxxxxxxxxxxxxx

# Note: the mock and ollama backends need no secrets:
#   --backend mock    canned responses, zero setup
#   --backend ollama  local server on http://localhost:11434
